#digest(
  title: "把权重换成可学习的一元函数：KAN 挑战多层感知机",
  src: "Liu 等 · ICLR 2025 · KAN",
  url: "https://doi.org/10.48550/arxiv.2404.19756",
  meta: "被引 4615",
