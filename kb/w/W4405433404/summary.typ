#digest(
  title: "一个模型同时跑流式与离线：CosyVoice 2 摊开了延迟的账，却没给毫秒数",
  src: "Zhihao Du 等（阿里巴巴） · arXiv 2412.10117 · cs.SD",
  url: "https://doi.org/10.48550/arxiv.2412.10117",
  meta: "被引 729",
  ratio: "原文 20 页 → 本篇 4 页（约 1/5）",
