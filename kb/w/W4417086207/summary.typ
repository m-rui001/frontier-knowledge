#digest(
  title: "把动作标签从视频里删掉：UniVLA 用「以任务为中心的潜在动作」把策略搬到不同机体上",
  src: "Qingwen Bu 等 · arXiv 2025 · UniVLA",
  url: "https://doi.org/10.48550/arxiv.2505.06111",
  meta: "被引 437",
  ratio: "原文 25 页 → 本篇 4 页（约 1/6）",
