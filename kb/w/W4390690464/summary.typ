#digest(
  title: "先把尺子校准，再花掉那笔算力",
  src: "DeepSeek 团队 · arXiv 2024 · DeepSeek LLM 7B / 67B",
  url: "https://arxiv.org/abs/2401.02954",
  meta: "被引 1501",
