#digest(
  title: "给大模型做一次脑部扫描：用两千万神经元找回它的概念",
  src: "Gao 等 · arXiv 2406.04093 · OpenAI 稀疏自编码器",
  url: "https://arxiv.org/abs/2406.04093",
  meta: "被引 813 · 1600 万特征、400 亿 token 的可解释性工程",
