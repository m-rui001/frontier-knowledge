#digest(
  title: "给高镍正极掺一点钇：把释氧的根源在电子结构里摁住",
  src: "Nature Communications 15, 8686 (2024) · Y2O3 掺杂高镍正极",
  url: "https://www.nature.com/articles/s41467-024-52768-7",
  meta: "被引 1199 · 210 mAh/g，100 循环 84% 保持",
