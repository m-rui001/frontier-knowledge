#digest(
  title: "让大模型当遗传算子：进化算法不再瞎突变",
  src: "MolLEO · arXiv 2406.16976 / ICLR 2025 · Georgia Tech 等",
  url: "https://arxiv.org/abs/2406.16976",
  meta: "被引 75 · LLM 接管交叉与变异，oracle 调用更少收敛更快",
  ratio: "原文约 30 页 → 本篇 4 页（约 1/7）",
