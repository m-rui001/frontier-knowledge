#digest(
  title: "antiSMASH 8.0：可识别的基因簇类型从 81 种涨到 101 种，裱糊工程照样有新东西",
  src: "Blin 等 · Nucleic Acids Research 2025 · antiSMASH 8.0",
  url: "https://doi.org/10.1093/nar/gkaf334",
  meta: "被引 907",
  ratio: "原文 7 页 → 本篇 4 页（约 1/2）",
