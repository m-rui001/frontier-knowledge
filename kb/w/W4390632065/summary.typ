#digest(
  title: "一张卡训九十天，把十一亿参数喂三万亿 token：TinyLlama 把训练过程全程直播",
  src: "Peiyuan Zhang 等（新加坡科技大学） · arXiv 2401.02385",
  url: "https://doi.org/10.48550/arxiv.2401.02385",
  meta: "被引 1248",
  ratio: "原文 12 页 → 本篇 4 页（约 1/3）",
