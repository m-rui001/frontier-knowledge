#digest(
  title: "把开源做到训练日志级：OLMo 2 用稳定化和退火把七 B 模型推到帕累托前沿",
  src: "OLMo Team · arXiv 2501.00656（cs.CL）· AI2",
  url: "https://doi.org/10.48550/arxiv.2501.00656",
  meta: "被引 893",
  ratio: "原文 30 页 → 本篇 4 页（约 1/8）",
