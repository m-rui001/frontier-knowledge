#digest(
  title: "群落被改造了，却没有被改成一样",
  src: "Keck 等（Altermatt 组） · Nature 2025, 641: 395–400 · 人类压力对生物多样性的全球元分析",
  url: "https://doi.org/10.1038/s41586-025-08752-2",
  meta: "被引 458",
