#digest(
  title: "NF-κB 四十年：一条被反复「全景式」综述的通路，这次把药也摆上了桌",
  src: "Guo 等 · Signal Transduction and Targeted Therapy 2024 · NF-κB 综述",
  url: "https://doi.org/10.1038/s41392-024-01757-9",
  meta: "被引 2652（Nature 页面另记 2537）",
  ratio: "原文 1 页 → 本篇 4 页（约 1/0）",
