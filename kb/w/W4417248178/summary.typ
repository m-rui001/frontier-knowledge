#digest(
  title: "在平 Chern 带里看到超导：扭转双层 MoTe₂ 里量子反常霍尔与超导共存",
  src: "Fan Xu 等（复旦大学等） · arXiv 2504.06972",
  url: "https://doi.org/10.48550/arxiv.2504.06972",
  meta: "被引 183",
  ratio: "摘要级转述（全文未取得）→ 本篇 4 页",
