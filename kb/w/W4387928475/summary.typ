#digest(
  title: "让机器人和虚拟人在家里一起干活：给具身 AI 造一个社交演练场",
  src: "Habitat 3.0 · arXiv 2310.13724 / ICLR 2024 · Meta AI",
  url: "https://arxiv.org/abs/2310.13724",
  meta: "被引 372 · 把人机协作变成可仿真的基准任务",
  ratio: "原文约 20 页 → 本篇 4 页（约 1/5）",
