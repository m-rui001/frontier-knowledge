#digest(
  title: "你的百分比是假的：当结果变量里有零，对数效应就动了尺度",
  src: "Chen & Roth · arXiv 2212.06080 · 计量经济学方法",
  url: "https://arxiv.org/abs/2212.06080",
  meta: "被引 1456 · 指出 log(1+Y) 类变换的一个隐蔽致命伤",
