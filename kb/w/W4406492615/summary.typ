#digest(
  title: "算力别平均分——按题目难度在测试时分配推理预算，四倍效率换掉一味堆参数",
  src: "Snell 等 · ICLR 2025 · 测试时计算最优扩展",
  url: "https://doi.org/10.48550/arxiv.2408.03314",
  meta: "被引 2592",
