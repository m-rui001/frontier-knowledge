#digest(
  title: "40 条记忆顶 60 万次训练：自动驾驶的「经验」用文字存就够了",
  src: "DiLu · arXiv 2309.16292 · 上海人工智能实验室",
  url: "https://arxiv.org/abs/2309.16292",
  meta: "被引 306 · 40 条经验 ≈ RL 60 万 episodes，迁移时 GRAD 掉 85%",
