#digest(
  title: "让语言模型读懂分子：InstructMol 把结构、序列和指令塞进同一条流水线",
  src: "Cao 等 · arXiv:2311.16208（q-bio.BM）2023 · InstructMol",
  url: "https://arxiv.org/abs/2311.16208",
  meta: "被引 110",
  ratio: "原文 15 页 → 本篇 4 页（约 1/4）",
