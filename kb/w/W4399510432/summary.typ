#digest(
  title: "把软件引用变成三次勾选：一个网站想改写天文学家的致谢",
  src: "Wagg 与 Broekgaarden · arXiv:2406.04405 · Software Citation Station",
  url: "https://arxiv.org/abs/2406.04405",
