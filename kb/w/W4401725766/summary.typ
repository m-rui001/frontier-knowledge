#digest(
  title: "把八种 U-Net 变体放在同一张桌上重训：谁赢取决于数据集，而不是架构",
  src: "Reza Azad, Ehsan Khodapanah Aghdam, Amelie Rauland 等（RWTH 亚琛 / 斯坦福 / 雷根斯堡） · IEEE TPAMI 2024 · arXiv 2211.14830",
  url: "https://doi.org/10.1109/tpami.2024.3435571",
  meta: "被引 1534",
