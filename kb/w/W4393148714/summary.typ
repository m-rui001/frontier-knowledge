#digest(
  title: "给扩散模型装一个对齐旋钮",
  src: "Mou · Wang · Xie · Wu · Zhang · Qi · Shan · AAAI 2024, 38(5) · T2I-Adapter",
  url: "https://doi.org/10.1609/aaai.v38i5.28226",
  meta: "arXiv 2302.08453（2023-02-16） · 被引 2250（source.txt 口径）",
